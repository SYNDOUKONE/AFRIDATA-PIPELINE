# Copier : cp .env.example .env

# PostgreSQL (Data Warehouse + metadata Airflow)
POSTGRES_USER=afridata
POSTGRES_PASSWORD=afridata_secret
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# MinIO (Data Lake S3)
MINIO_ROOT_USER=afridata
MINIO_ROOT_PASSWORD=afridata_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DATALAKE_BUCKET=datalake

# Kafka
KAFKA_PORT=9092

# Spark
SPARK_UI_PORT=4040

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_USER=afridata
AIRFLOW_PASSWORD=afridata

# Pipeline
NB_TRANSACTIONS=1000000
BASE_CURRENCY=XOF
